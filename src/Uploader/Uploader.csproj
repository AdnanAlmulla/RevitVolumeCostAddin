<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The uploader: a small program, one build for every Revit year, that sends the add-in's outbox to the website
    (CLAUDE.md "The add-in writes, the uploader sends"). .NET 8, which Revit 2025 and 2026 install on every
    modeller's PC. No third-party packages. Microsoft sign-in is deferred (engineer, 2026-11-26).
  -->
  <PropertyGroup>
    <!-- No window: it runs from Windows sign-in, and its log is %LocalAppData%\<product>\Logs\uploader.log. -->
    <OutputType>WinExe</OutputType>
    <!-- Windows only (it sets the start at sign-in in the registry); needs only the base .NET 8 runtime. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>$(ProductName).Uploader</AssemblyName>
    <RootNamespace>Uploader</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Release numbers and the manifest's version folder, read with the same code as the add-in's. -->
    <Compile Include="..\Addin\Updates\ReleaseVersions.cs" Link="Shared\ReleaseVersions.cs" />
  </ItemGroup>
</Project>
