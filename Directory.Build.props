<Project>
  <!--
    The product's name lives here and nowhere else in code: Telltale (engineer, 2026-11-27; "RevitVolumeCost" until
    0.6.0). The add-in's assembly, its folder, its .addin manifest, the ribbon tab and every folder and file it and the
    uploader use take their name from it. C# namespaces are written in source, so they stay neutral ("Addin",
    "Contracts") and never carry the name. The installer also knows the former names, to clear an old copy away
    (installer/Move-FormerInstall.ps1).
  -->
  <PropertyGroup>
    <ProductName>Telltale</ProductName>
    <Version>0.7.0</Version>
    <Authors>Adnan Almulla @ Killa Design</Authors>
    <Company>Killa Design</Company>
    <Product>$(ProductName)</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
